# ============================================================================
#  Khiam Ops — ملف المفاتيح (نموذج)
#  انسخ الملف ده باسم  .env  في نفس الفولدر (apps/backend/.env) واملا القيم.
#  الـ .env الحقيقي متجاهَل في git — مفاتيحك تفضل على جهازك ومابترفعش.
#  مش محتاج تبعتلي أي مفتاح في الشات — حطّه هنا وأنا أقراه من هنا.
#  شيل علامة # من قدام أي سطر عشان تفعّله.
# ============================================================================

# ───────────── (1) أساسيات — مربوطة وتشتغل دلوقتي ─────────────
PORT=8787
SIMULATE=1                 # 1 = محاكاة بيانات (للتطوير فقط) · أي قيمة أخرى/غير محدّد = إيقاف · ويُتجاهَل تلقائيًا لو NODE_ENV=production
# NODE_ENV=production      # فعّلها في الإنتاج (يفرض التحقق الصارم من الأسرار تحت)

# ───────────── (2) الأمان — مهم جدًا للإنتاج (مربوط) ─────────────
# سر توقيع التوكنات — لازم ثابت وقوي في الإنتاج. ولّد واحد بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=ضع_هنا_64_حرف_عشوائي

# كود دخول المدير للداشبورد (بدل ADMIN التجريبي). في الإنتاج بدونه دخول المدير مقفول.
# ADMIN_CODE=ضع_كود_سري_قوي

# TOKEN_TTL_MS=57600000      # مدة صلاحية التوكن (افتراضي 16 ساعة)
# LOGIN_WINDOW_MS=60000      # نافذة عدّ محاولات الدخول (ضد التخمين)
# LOGIN_MAX_FAILS=8          # محاولات فاشلة مسموحة قبل الحظر المؤقت
# LOGIN_BLOCK_MS=300000      # مدة الحظر بعد التجاوز (5 دقائق)

# حدّ معدّل per-employee على مسارات الكتابة (ضد نفخ الأرقام/الطلبات الوهمية بالتوكن المُعاد).
# الحدود سخيّة (تمسك السكربتات لا الموظف المشغول)؛ التجاوز = تنبيه "نشاط آلي" + 429. القيم لكل دقيقة.
# RATE_ACTIVITY_PER_MIN=120    # ردود/تعليقات/أوردرات
# RATE_PRESENCE_PER_MIN=120    # نبضات (عدّة تبويبات + البرنامج)
# RATE_QUEUE_PER_MIN=90        # استلام/إنهاء مهام الطابور
# RATE_EVALUATE_PER_MIN=60     # تقييم AI (تكلفة)
# RATE_SYNC_PER_MIN=40         # مزامنة الإنبوكس/الطابور
# RATE_SCREENSHOTS_PER_MIN=90  # رفع لقطات الشاشة
# RATE_HISTORY_PER_MIN=15      # سحب الهيستوري

# ───────────── (3) ثبات البيانات — مربوط ─────────────
# DATA_FILE=.data/store.json # مكان حفظ اللقطة (الافتراضي كافٍ)
# SAVE_INTERVAL_MS=8000      # كل قد إيه يحفظ

# ───────────── (4) الذكاء الاصطناعي — مربوط (اختياري، فيه fallback محلي) ─────────────
# التقييم يشتغل محليًا بدون أي مفتاح. حط مفتاح واحد أو أكثر لتفعيل التقييم الحقيقي (بالترتيب):
# GROQ_API_KEY=gsk_xxxxxxxx            # الأسهل والأسرع — console.groq.com
# GROQ_MODEL=openai/gpt-oss-120b       # الافتراضي (llama-3.3-70b-versatile اتوقّف في Groq)
# OPENROUTER_API_KEY=sk-or-xxxxxxxx    # بديل — openrouter.ai
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# GEMINI_API_KEY=xxxxxxxx              # بديل — aistudio.google.com
# GEMINI_MODEL=gemini-1.5-flash

# ───────────── (5) تكاملات بسيطة — مربوطة (اختيارية، بدون حسابات ثقيلة) ─────────────
# GOOGLE_SHEET_WEBHOOK=https://script.google.com/.../exec  # Apps Script (المخالفات تتسجّل في شيت)
# NTFY_TOPIC=khiam-alerts-xxxx                             # ntfy.sh (تنبيه فوري للموبايل للمخالفات الحرجة)
# QUEUE_STRICT=1                                           # 1 = طابور ميتا إجباري · 0 = يدوي

# ============================================================================
#  (6) خدمات تُربَط لاحقًا — placeholders (نملاها خطوة بخطوة لما نوصل لكل واحدة.)
# ============================================================================

# ── Supabase (قاعدة البيانات الدائمة) — ✅ مربوط في الكود ──
# أول ما تحط السطرين دول، الـ backend بيخزّن لقطة الحالة في Supabase (جدول ops_snapshot)
# تلقائيًا، والملف المحلي يفضل احتياطي. تأكّد إنك طبّقت supabase/schema.sql (أو snapshot.sql).
# من: supabase.com → مشروعك → Project Settings → API
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # مفتاح السيرفر (سرّي جدًا — يتخطّى RLS)
# SUPABASE_ANON_KEY=eyJhbGciOi...           # مفتاح عام (للواجهة لاحقًا — اختياري دلوقتي)

# ── Upstash Redis (الحالة اللحظية) — اختياري، نأجّله ──
# من: upstash.com → Redis → REST API
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ── Cloudflare R2 (تخزين لقطات الشاشة) — ✅ مربوط في الكود ──
# أول ما تحط الأربعة دول، لقطات الشاشة بتترفع لـ R2 تلقائيًا (توقيع SigV4، بدون مكتبات)،
# والداشبورد بيجيبها برابط موقّع مؤقّت — والذاكرة تتفضّى من الصور. بدونهم: اللقطات في الذاكرة.
# أنشئ bucket (مثلاً khiam-screenshots) + API Token (صلاحية Object Read & Write).
# من: dash.cloudflare.com → R2 → Manage R2 API Tokens
# لو عندك توكن بصيغة cfat_ بدل مفاتيح S3 جاهزة، تقدر تشتقّهم (المسار الرسمي لـ R2):
#   Access Key ID      = معرّف التوكن (token id — من /accounts/<acct>/tokens/verify)
#   Secret Access Key  = SHA-256(قيمة التوكن الكاملة cfat_…)
#   Account ID         = من أعلى يمين صفحة R2
# R2_ACCOUNT_ID=xxxxxxxx          # معرّف حسابك في Cloudflare (أعلى يمين R2)
# R2_ACCESS_KEY_ID=xxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxx
# R2_BUCKET=khiam-screenshots

# ── Meta API + بوت التعليقات (المسار الرسمي: رسائل/تعليقات ميتا) — ✅ مربوط في الكود ──
# أول ما تحط META_PAGE_ACCESS_TOKEN، بوت التعليقات يفحص تعليقات صفحتك دوريًا، يصنّفها
# (نية شراء / استفسار / شكوى) ويغذّي طابور ميتا تلقائيًا. بدونه: نائم — يعمل عبر POST /api/comments/ingest.
# من: developers.facebook.com → تطبيقك → Settings/Tokens (صلاحية قراءة منشورات/تعليقات الصفحة)
# META_APP_ID=xxxxxxxx
# META_APP_SECRET=xxxxxxxx
# META_PAGE_ACCESS_TOKEN=EAAxxxxxxxx         # توكن الصفحة طويل الأمد (يفعّل بوت التعليقات)
# META_PAGE_ID=xxxxxxxx                      # معرّف الصفحة (الافتراضي: me)
# META_GRAPH_VERSION=v21.0                   # نسخة Graph API
# COMMENTS_POLL_MS=60000                     # كل قد إيه يفحص (افتراضي دقيقة)
# COMMENTS_FEED_LIMIT=10                     # كام منشور حديث يفحص تعليقاته
# META_WEBHOOK_VERIFY_TOKEN=أنا_أولّده_لك     # لمصافحة التحقق (أنا أحدده)

# ── واتساب تلقائي (WAHA) — ✅ مربوط في الكود (نائم بدون WAHA_URL) ──
# أول ما تحط WAHA_URL، الداشبورد يقدر يبعت تقارير/ملخّصات لواتساب الموظف تلقائيًا
# (POST /api/waha/send، بفعل أدمن صريح) بدل رابط wa.me اليدوي. بدونه: wa.me زي ما هو.
# شغّل WAHA (مثلاً: docker run -it -p 3000:3000 devlikeapro/waha) وامسح QR برقم الشركة.
# WAHA_URL=http://localhost:3000
# WAHA_SESSION=default
# WAHA_API_KEY=                    # اختياري — لو فعّلت حماية WAHA بمفتاح (هيدر X-Api-Key)
