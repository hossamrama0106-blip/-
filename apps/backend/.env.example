# إعدادات الـ backend المحلي
PORT=8787
SIMULATE=1

# بيئة التشغيل — في الإنتاج اضبطها production (يفعّل التحقق الصارم من الأسرار أدناه).
# NODE_ENV=production

# ───────── الأمان (مهم للإنتاج) ─────────
# سر توقيع التوكنات — لازم ثابت وقوي في الإنتاج (وإلا كل التوكنات تتبطّل مع أي إعادة تشغيل).
# ولّد واحد عشوائي:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=ضع_هنا_64_حرف_عشوائي

# كود دخول المدير للداشبورد. في التطوير الافتراضي ADMIN؛ في الإنتاج لازم تحدده (وإلا دخول المدير مقفول).
# ADMIN_CODE=ضع_كود_سري_قوي

# مدة صلاحية التوكن بالملي ثانية (الافتراضي 16 ساعة).
# TOKEN_TTL_MS=57600000

# حارس محاولات الدخول (ضد تخمين الأكواد) — القيم الافتراضية كافية عادةً.
# LOGIN_WINDOW_MS=60000      # نافذة العدّ (دقيقة)
# LOGIN_MAX_FAILS=8          # محاولات فاشلة مسموحة بالنافذة قبل الحظر
# LOGIN_BLOCK_MS=300000      # مدة الحظر بعد التجاوز (5 دقائق)

# ───────── الذكاء الاصطناعي (اختياري) ─────────
# تقييم الردود يعمل محلياً (heuristic) بدون أي مفتاح.
# ضع مفتاح Groq لتفعيل التقييم الحقيقي (Llama) + تفريغ الصوت لاحقاً:
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile
